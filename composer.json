{
    "name": "sympress/nginx-cache",
    "description": "Kernel-integrated Nginx edge cache purge package for WordPress.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Brian Schäffner",
            "email": "brian.schaeffner@sympress.io",
            "role": "Developer"
        }
    ],
    "require": {
        "ext-dom": "*",
        "ext-sodium": "*",
        "php": "^8.5",
        "predis/predis": "^3.6",
        "symfony/clock": "^8.0",
        "symfony/console": "^8.0",
        "symfony/filesystem": "^8.0",
        "symfony/finder": "^8.0",
        "symfony/http-client": "^8.0",
        "symfony/lock": "^8.0",
        "symfony/options-resolver": "^8.0",
        "sympress/event-dispatcher": "^1.0.2",
        "sympress/kernel": "^1.1.1",
        "sympress/wp-cli-console": "^1.0.2"
    },
    "require-dev": {
        "symfony/var-dumper": "^8.1",
        "sympress/qa": "^0.1.2"
    },
    "autoload": {
        "psr-4": {
            "SymPress\\NginxCache\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SymPress\\NginxCache\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "cs": [
            "Composer\\Config::disableProcessTimeout",
            "qa cs"
        ],
        "cs:fix": [
            "Composer\\Config::disableProcessTimeout",
            "qa cs:fix"
        ],
        "static-analysis": [
            "Composer\\Config::disableProcessTimeout",
            "qa static-analysis"
        ],
        "tests": [
            "Composer\\Config::disableProcessTimeout",
            "qa tests"
        ],
        "test": [
            "@tests"
        ],
        "qa": [
            "@cs",
            "@static-analysis",
            "@tests"
        ],
        "tests:integration": [
            "Composer\\Config::disableProcessTimeout",
            "php tests/Integration/run.php",
            "php tests/Integration/query-contention.php"
        ],
        "tests:nginx": [
            "Composer\\Config::disableProcessTimeout",
            "php tests/Integration/nginx-config.php"
        ],
        "tests:multisite": [
            "Composer\\Config::disableProcessTimeout",
            "php tests/Integration/multisite.php"
        ]
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "wordpress-install-dir": "vendor/wordpress/wordpress",
        "kernel": {
            "bundle": "SymPress\\NginxCache\\NginxCacheBundle",
            "entry": "nginx-cache/nginx-cache.php"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
